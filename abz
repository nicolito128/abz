#!/usr/bin/env python3

import argparse
import sys

from ioz import ReadWriteCloser, Bytes, File
from codecz import Codec, WordMap


CODECS: dict[str, type[Codec]] = {
    "wordmap": WordMap,
}


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="ABZ: compresor de archivos")
    _ = parser.add_argument("-codec", required=True, choices=CODECS,
                        help="algoritmo a utilizar")
    _ = parser.add_argument("-i", metavar="FILE",
                        help="archivo de entrada")
    _ = parser.add_argument("-o", metavar="FILE",
                        help="archivo de salida (si se omite, imprime en consola)")
    _ = parser.add_argument("-d", action="store_true",
                        help="decodificar en lugar de codificar")
    return parser.parse_args()


def main() -> None:
    args = parse_args()
    codec = CODECS[args.codec]()

    src : ReadWriteCloser
    if args.i:
        src = File(args.i)
    else:
        in_data = input().encode()
        src = Bytes(in_data)

    dst : ReadWriteCloser
    if args.o:
        dst = File(args.o, "wb")
    else:
        dst = Bytes()

    if args.d:
        _ = codec.decode(dst, src)
    else:
        _ = codec.encode(dst, src)


    match dst:
        case Bytes():
            _ = sys.stdout.buffer.write(dst.data())
        case _:
            pass


if __name__ == "__main__":
    main()
